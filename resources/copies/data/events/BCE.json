{
    "add_namespace": "BCE_border_conflict_won_attacker",
    "country_event": {
        "id": "BCE_border_conflict_won_attacker.1",
        "title": "BCE_border_conflict_won_attacker.1.t",
        "desc": "BCE_border_conflict_won_attacker.1.desc",
        "picture": "GFX_BCE_border_war_event",
        "is_triggered_only": true,
        "immediate": {
            "hidden_effect": {
                "save_event_target_as": "our_country",
                "FROM": {
                    "save_event_target_as": "our_state",
                    "clr_state_flag": "border_incident_active"
                },
                "FROM.FROM": {
                    "save_event_target_as": "their_country"
                },
                "FROM.FROM.FROM": {
                    "save_event_target_as": "their_state",
                    "clr_state_flag": "border_incident_active"
                },
                "remove_targeted_decision": {
                    "target": "event_target:their_country",
                    "decision": "BCE_border_conflict_time_until_cancelled"
                }
            }
        },
        "option": {
            "name": "BCE_border_conflict_won_attacker.1.a",
            "add_political_power": 50,
            "add_war_support": 0.02,
            "if": {
                "limit": {
                    "check_variable": {
                        "FROM.FROM.num_owned_states > 1": null
                    }
                },
                "transfer_state": "FROM.FROM.FROM"
            },
            "else": {
                "FROM.FROM": {
                    "ROOT": {
                        "annex_country": {
                            "target": "PREV"
                        }
                    }
                }
            },
            "custom_effect_tooltip": "BCE_buildings_damaged",
            "hidden_effect": {
                "FROM.FROM.FROM": {
                    "random_list": {
                        "seed": "random",
                        "60": {
                            "damage_building": {
                                "type": "arms_factory",
                                "damage": 0.6
                            }
                        },
                        "30": {
                            "damage_building": {
                                "type": "arms_factory",
                                "damage": 0.3
                            }
                        },
                        "10": {
                            "damage_building": {
                                "type": "industrial_complex",
                                "damage": 0.9
                            }
                        }
                    }
                }
            }
        }
    },
