{
    "on_actions": {
        "on_startup": {
            "effect": {
                "every_possible_country": {
                    "set_variable": {
                        "var": "VAR_FINANCIAL_CENTER_DEV_BONDS_PER",
                        "value": 20
                    },
                    "COMPUTE_NUM_FINANCIAL_CENTERS": true
                }
            }
        },
        "on_monthly": {
            "effect": {
                "COMPUTE_NUM_FINANCIAL_CENTERS": true,
                "set_temp_variable": {
                    "var": "num_dev_bonds_to_produce",
                    "value": "VAR_NUM_FINANCIAL_CENTERS_OWNED"
                },
                "multiply_temp_variable": {
                    "var": "num_dev_bonds_to_produce",
                    "value": "VAR_FINANCIAL_CENTER_DEV_BONDS_PER"
                },
                "add_to_variable": {
                    "var": "VAR_INVENTORY_ITEM_3RA_WETM_DEV_BONDS",
                    "value": "num_dev_bonds_to_produce"
                },
                "INVENTORY_RELOAD_ONLY_WHEN_OPEN": true
            }
        }
    }
}