                        "create_unit__D1": {
                            "division": "name = \"中型坦克模型测试师 (Medium Armor Model Test)\" division_template = \"风魔中型装甲力量 (Windigo Medium Armor Force)\" start_experience_factor = 1.0 start_equipment_factor = 1.0 start_manpower_factor = 1.0",
                            "owner": "C26",
