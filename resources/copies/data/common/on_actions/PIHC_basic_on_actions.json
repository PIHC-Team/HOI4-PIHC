{
    "on_actions": {
        "on_nuke_drop": {
            "effect": {
                "FROM": {
                    "owner": {
                        "if": {
                            "limit": {
                                "NOT": {
                                    "has_country_flag": "PIHC_COUNTRY_FLAG_FAKE_NUKE_DROP"
                                }
                            },
                            "country_event": {
                                "id": "NUKES.1"
                            }
                        }
                    },
                    "add_state_modifier": {
                        "modifier": {
                            "local_manpower": -0.30,
                            "local_org_regain": -0.50,
                            "state_resources_factor": -0.20
                        }
                    },
                    "every_state_division": {
                        "random_list": {
                            "seed": "random",
                            "60": {
                                "destroy_unit": true
                            },
                            "40": {
                                "set_unit_organization": 0.0
                            }
                        }
                    },
                    "every_neighbor_state": {
                        "add_state_modifier": {
                            "modifier": {
                                "local_manpower": -0.15,
                                "local_org_regain": -0.10,
                                "state_resources_factor": -0.05
                            }
                        },
                        "every_state_division": {
                            "random_list": {
                                "seed": "random",
                                "10": {
                                    "destroy_unit": true
                                },
                                "30": {
                                    "set_unit_organization": 0.0
                                },
                                "40": {
                                    "set_unit_organization": 0.1
                                },
                                "20": {
                                    
                                }
                            }
                        }
                    }
                }
            }
        },
        "on_paradrop": {
