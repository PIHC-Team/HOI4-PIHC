                        },
                        "create_unit__D2": {
                            "division": "name = \"重型坦克模型测试师 (Heavy Armor Model Test)\" division_template = \"风魔重型装甲力量 (Windigo Heavy Armor Force)\" start_experience_factor = 1.0 start_equipment_factor = 1.0 start_manpower_factor = 1.0",
                            "owner": "C26",
                            "count": 1,
