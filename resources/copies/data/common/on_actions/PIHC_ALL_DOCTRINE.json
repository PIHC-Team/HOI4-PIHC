{
    "on_actions": {
        "on_startup": {
            "effect": {
                "every_possible_country": {
                    "army_experience": 125,
                    "air_experience": 25,
                    "if": {
                        "limit": {
                            "any_controlled_state": {
                                "is_coastal": true
                            }
                        },
                        "add_naval_experience": 50
                    },
                    "if__D1": {
                        "limit": {
                            "is_magic_country": true
                        },
                        "add_political_power": 20
                    }
                }
            }
        }
    }
}