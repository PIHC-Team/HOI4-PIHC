            "value": 0.03
        },
        "add_to_variable__D2": {
            "var": "global.VAR_EIJC_GOODS_BOOST",
            "value": 0.01
        },
        "clamp_variable__D2": {
            "var": "global.VAR_EIJC_GOODS_BOOST",
            "min": 0.00,
            "max": 0.25
        },
        "multiply_variable__D3": {
            "var": "global.VAR_EIJC_GOODS_BOOST",
