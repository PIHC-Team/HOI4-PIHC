            "value": 0.05
        },
        "clamp_variable__D3": {
            "var": "global.VAR_EIJC_BUILDINGS_BOOST",
            "min": 0.00,
            "max": 0.75
        },

        "set_variable__D5": {
            "var": "global.VAR_EIJC_RESOURCES_BOOST",
            "value": "global.VAR_EIJC_NUM_MEMBERS"
        },
        "multiply_variable__D5": {
            "var": "global.VAR_EIJC_RESOURCES_BOOST",
