    "COMPUTE_NUM_RESEARCHES_IN_STATE": {
        "set_variable": {
            "var": "VAR_NUM_RESEARCHES_IN_CURRENT_STATE",
            "value": 0
        },
        "if": {
            "limit": {
                "research_complex > 0": null
            },
            "add_to_variable": {
                "var": "VAR_NUM_RESEARCHES_IN_CURRENT_STATE",
                "value": 1
            }
        }
    },
    "COMPUTE_NUM_RESEARCHES": {
        "set_variable": {
            "var": "THIS.VAR_NUM_RESEARCHES_OWNED",
            "value": 0
        },
        "every_controlled_state": {
            "COMPUTE_NUM_RESEARCHES_IN_STATE": true,
            "add_to_variable": {
                "var": "PREV.VAR_NUM_RESEARCHES_OWNED",
                "value": "THIS.VAR_NUM_RESEARCHES_IN_CURRENT_STATE"
            }
        }
    },
