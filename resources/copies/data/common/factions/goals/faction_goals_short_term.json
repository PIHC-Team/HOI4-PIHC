    "faction_goal_spy_master": {
        "name": "spy_master_goal_name",
        "description": "spy_master_goal_desc",
        "group": "FOCUS_FILTER_POLITICAL_CHARACTER",
        "category": "short_term",
        "allowed": {
            "has_dlc": "La Resistance"
        },
        "visible": {
            "FROM": {
                "is_spymaster": false,
                "any_allied_country": {
                    "is_spymaster": false
                }
            }
        },
        "completed": {
            "OR": {
                "is_spymaster": true,
                "any_allied_country": {
                    "is_spymaster": true
                }
            }
        },
        "complete_effect": {
            "add_faction_power_projection": 50,
            "custom_effect_tooltip": "generic_skip_one_line_tt",
            "custom_effect_tooltip__D1": "THE_SPY_MASTER",
            "add_faction_initiative": 1,
            "custom_effect_tooltip__D2": "generic_skip_one_line_tt",
            "every_faction_member": {
                "limit": {
                    "has_intelligence_agency": false
                },
                "create_intelligence_agency": true
            },
            "every_faction_member__D1": {
                "limit": {
                    "has_intelligence_agency": true,
                    "NOT": {
                        "has_done_agency_upgrade": "upgrade_form_department"
                    }
                },
                "upgrade_intelligence_agency": "upgrade_form_department"
            },
            "every_faction_member__D2": {
                "limit": {
                    "has_intelligence_agency": true,
                    "has_done_agency_upgrade": "upgrade_form_department",
                    "NOT": {
                        "has_done_agency_upgrade": "upgrade_crypto_strength"
                    }
                },
                "upgrade_intelligence_agency": "upgrade_crypto_strength"
            },
            "every_faction_member__D3": {
                "limit": {
                    "has_intelligence_agency": true,
                    "has_done_agency_upgrade": "upgrade_crypto_strength",
                    "has_tech": "mechanical_computing",
                    "NOT": {
                        "has_done_agency_upgrade": "upgrade_crypto_strength_2"
                    }
                },
                "add_faction_initiative": 1,
                "upgrade_intelligence_agency": "upgrade_crypto_strength_2"
            },
            "every_faction_member__D4": {
                "limit": {
                    "has_intelligence_agency": true,
                    "NOT": {
                        "agency_upgrade_number > 30": null
                    },
                    "OR": {
                        "has_done_agency_upgrade": "upgrade_crypto_strength_2",
                        "NOT": {
                            "has_tech": "mechanical_computing"
                        }
                    }
                },
                "add_faction_initiative": 1,
                "gain_random_agency_upgrade": true
            },
            "every_faction_member__D5": {
                "visible_when_empty": true,
                "limit": {
                    "has_intelligence_agency": true,
                    "agency_upgrade_number > 30": null
                },
                "add_faction_initiative": 1,
                "add_political_power": 100
            }
        },
        "ai_will_do": {
            "base": 1,
            "modifier": {
                "add": 2,
                "has_intelligence_agency": true
            }
        }
    },
