[l_english.INVENTORY_ITEM_4EP_C02_RABID_RHODODENDRONS_NEUTRALIZER]
Rabid Rhododendrons Neutralizer

[l_english.INVENTORY_ITEM_4EP_C02_RABID_RHODODENDRONS_NEUTRALIZER_DESC]
