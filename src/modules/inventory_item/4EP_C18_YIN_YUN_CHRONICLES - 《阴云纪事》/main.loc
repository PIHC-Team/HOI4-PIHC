[l_simp_chinese.INVENTORY_ITEM_4EP_C18_YIN_YUN_CHRONICLES]
《阴云纪事》

[l_simp_chinese.INVENTORY_ITEM_4EP_C18_YIN_YUN_CHRONICLES_DESC]
