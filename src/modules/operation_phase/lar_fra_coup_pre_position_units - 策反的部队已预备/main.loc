[l_braz_por]
lar_fra_coup_pre_position_units=Pré-posicionar unidades
lar_fra_coup_pre_position_units_desc=Nosso agente assumirá o comando de um número de unidades do exército complacentes na região e as atribuirá objetivos a serem conquistados quando a operação começar.
lar_fra_coup_pre_position_units_outcome=

[l_english]
lar_fra_coup_pre_position_units=Pre-Position Units
lar_fra_coup_pre_position_units_desc=Our agent will take charge of a number of sympathetic army units in the area and assign them objectives to be seized when the operation commences.
lar_fra_coup_pre_position_units_outcome=

[l_french]
lar_fra_coup_pre_position_units=Prépositionnement des unités
lar_fra_coup_pre_position_units_desc=Notre agent va entrer en contact avec un certain nombre d'unités de l'armée gagnées à notre cause pour leur indiquer les objectifs à prendre au lancement des opérations.
lar_fra_coup_pre_position_units_outcome=

[l_german]
lar_fra_coup_pre_position_units=Einheiten in Position bringen
lar_fra_coup_pre_position_units_desc=Unser Agent übernimmt die Kontrolle über Armeeeinheiten im Zielgebiet, die mit unserer Sache sympathisieren. Diese Einheiten bekommen vorab Ziele zugewiesen, die sie dann zu Beginn der Operation unverzüglich einnehmen.
lar_fra_coup_pre_position_units_outcome=

[l_japanese]
lar_fra_coup_pre_position_units=部隊の事前配置
lar_fra_coup_pre_position_units_desc=諜報員は地域の同調的な陸軍部隊を担当し、作戦が開始されたときに目標の割り当てを行う。
lar_fra_coup_pre_position_units_outcome=

[l_korean]
lar_fra_coup_pre_position_units=사전 배치 부대
lar_fra_coup_pre_position_units_desc=공작원이 해당 지역에 있는 우호적인 군부대 몇몇을 지휘하게 되며, 작전 개시 시점에 점령해야 할 목표들을 이들에게 할당할 것입니다.
lar_fra_coup_pre_position_units_outcome=

[l_polish]
lar_fra_coup_pre_position_units=Wcześniejsze rozmieszczenie jednostek
lar_fra_coup_pre_position_units_desc=Nasz agent obejmie dowodzenie nad kilkoma stacjonującymi w tym rejonie sympatyzującymi z nami jednostkami wojska i wyznaczy im cele, które będą miały zająć, gdy rozpocznie się operacja.
lar_fra_coup_pre_position_units_outcome=

