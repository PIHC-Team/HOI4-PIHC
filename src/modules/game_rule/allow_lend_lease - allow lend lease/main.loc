[l_braz_por]
RULE_ALLOW_LEND_LEASE=Empréstimo e arrendamento
RULE_ALLOW_LEND_LEASE_BLOCKED_DESC=Países nunca podem emprestar equipamentos para outras nações.
RULE_ALLOW_LEND_LEASE_FREE_DESC=Países podem realizar empréstimos de equipamentos com qualquer país com Tensão mundial.
RULE_ALLOW_LEND_LEASE_LIMITED_DESC=Empréstimos e arrendamentos limitados por regras de Tensão mundial e ideologias.
RULE_ALLOW_LEND_LEASE_SAME_FACTION_DESC=Os países só podem realizar empréstimos com países da mesma facção.
RULE_ALLOW_LEND_LEASE_SAME_IDEOLOGY_DESC=Os países só podem realizar empréstimos com países da mesma ideologia.
allow_lend_lease=allow lend lease
allow_lend_lease_desc=

[l_english]
