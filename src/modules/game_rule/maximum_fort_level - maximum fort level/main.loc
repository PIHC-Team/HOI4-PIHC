[l_braz_por]
RULE_MAXIMUM_FORT_LEVEL=Fortes no nível máximo
RULE_MAXIMUM_FORT_LEVEL_DESC=Países só podem construir fortes em terra e na costa até o nível selecionado. As fortificações presentes no início do jogo não são afetadas. Prédios de focos nacionais, decisões e eventos podem exceder o nível selecionado.
RULE_MAXIMUM_FORT_LEVEL_NORMAL_DESC=Países podem construir fortes em terra e na costa de acordo com as restrições normais.
RULE_OPTION_1=Nível 1
