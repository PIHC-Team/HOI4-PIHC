[l_braz_por]
RULE_ALLOW_LICENSING=Produção de licenças
RULE_ALLOW_LICENSING_BLOCKED_DESC=Países nunca podem adquirir licenças de produção sem decisões ou eventos especiais.
RULE_ALLOW_LICENSING_FREE_DESC=Os países podem adquirir licenças de produção de qualquer país.
RULE_ALLOW_LICENSING_SAME_FACTION_DESC=Países só podem conseguir acesso militar e direito de aportar apenas de países da mesma facção.
RULE_ALLOW_LICENSING_SAME_IDEOLOGY_DESC=Países só podem conseguir acesso militar e direito de aportar apenas de países que compartilhem de sua ideologia.
allow_licensing=allow licensing
allow_licensing_desc=

