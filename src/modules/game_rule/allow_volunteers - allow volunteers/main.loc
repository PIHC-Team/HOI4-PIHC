[l_braz_por]
RULE_ALLOW_VOLUNTEERS=Voluntários
RULE_ALLOW_VOLUNTEERS_BLOCKED_DESC=Países nunca podem enviar voluntários para qualquer outro país.
RULE_ALLOW_VOLUNTEERS_FREE_DESC=Países podem enviar voluntários para qualquer país independente da Tensão mundial.
RULE_ALLOW_VOLUNTEERS_LIMITED_DESC=Envio de voluntários limitado por regras de Tensão mundial e ideologias.
RULE_ALLOW_VOLUNTEERS_SAME_IDEOLOGY_DESC=Países só podem enviar voluntários apenas de países que compartilhem de sua ideologia.
allow_volunteers=allow volunteers
allow_volunteers_desc=

