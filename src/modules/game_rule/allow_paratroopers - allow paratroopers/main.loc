[l_braz_por]
RULE_ALLOW_PARATROOPERS=Saltos de paraquedas com suprimentos
RULE_ALLOW_PARATROOPERS_ALLOWED_DESC=Países podem realizar saltos de paraquedas com suprimentos.
RULE_ALLOW_PARATROOPERS_BLOCKED_DESC=Países não podem realizar saltos de paraquedas com suprimentos. Divisões de paraquedismo ainda podem ser recrutadas mas não poderão executar ataques aéreos.
allow_paratroopers=allow paratroopers
allow_paratroopers_desc=

[l_english]
RULE_ALLOW_PARATROOPERS=Paradrops
RULE_ALLOW_PARATROOPERS_ALLOWED_DESC=Countries may execute parachute drops freely.
RULE_ALLOW_PARATROOPERS_BLOCKED_DESC=Countries may not execute parachute drops under any circumstances. Paratrooper divisions may still be recruited, but will not be able to execute airborne attacks.
allow_paratroopers=allow paratroopers
allow_paratroopers_desc=

[l_french]
RULE_ALLOW_PARATROOPERS=Parachutages
RULE_ALLOW_PARATROOPERS_ALLOWED_DESC=Il est possible d'effectuer des parachutages en toute circonstance.
RULE_ALLOW_PARATROOPERS_BLOCKED_DESC=Il est impossible d'effectuer des parachutages, quelles que soient les circonstances. Les divisions parachutistes pourront toujours être recrutées, mais incapables d'effectuer des attaques aéroportées.
allow_paratroopers=allow paratroopers
allow_paratroopers_desc=

[l_german]
RULE_ALLOW_PARATROOPERS=Fallschirmjägerabsprünge
RULE_ALLOW_PARATROOPERS_ALLOWED_DESC=Länder können Fallschirmjägerabsprünge frei ausführen.
RULE_ALLOW_PARATROOPERS_BLOCKED_DESC=Länder können unter keinen Umständen Fallschirmjägerabsprünge ausführen. Es können weiterhin Fallschirmjägerdivisionen rekrutiert werden, sie können jedoch keine Luftangriffe ausführen.
allow_paratroopers=allow paratroopers
allow_paratroopers_desc=

[l_japanese]
RULE_ALLOW_PARATROOPERS=空挺降下
RULE_ALLOW_PARATROOPERS_ALLOWED_DESC=各国は自由に空挺降下できるでしょう。
RULE_ALLOW_PARATROOPERS_BLOCKED_DESC=各国はどんな状況下でも空挺降下できないでしょう。空挺師団は徴兵できるでしょうが、空挺攻撃は実行できません。
allow_paratroopers=allow paratroopers
allow_paratroopers_desc=

[l_korean]
RULE_ALLOW_PARATROOPERS=공수 강하
RULE_ALLOW_PARATROOPERS_ALLOWED_DESC=모든 국가가 자유롭게 공수 강하를 실행할 수 있습니다.
RULE_ALLOW_PARATROOPERS_BLOCKED_DESC=국가와 상황을 막론하고 어떤 상황에서도 공수 강하를 실행할 수 없습니다. 공수사단의 편성은 가능하나, 공중 강습은 실행할 수 없습니다.
allow_paratroopers=allow paratroopers
allow_paratroopers_desc=

[l_polish]
RULE_ALLOW_PARATROOPERS=Desanty powietrzne
RULE_ALLOW_PARATROOPERS_ALLOWED_DESC=Kraje mogą dowolnie przeprowadzać desanty powietrzne.
RULE_ALLOW_PARATROOPERS_BLOCKED_DESC=Kraje nie mogą przeprowadzać desantów powietrznych. Można nadal tworzyć dywizje spadochronowe, ale nie będą one mogły dokonywać ataków powietrznodesantowych.
allow_paratroopers=allow paratroopers
allow_paratroopers_desc=

[l_russian]
RULE_ALLOW_PARATROOPERS=Десантирование
RULE_ALLOW_PARATROOPERS_ALLOWED_DESC=Государства могут применять десантирование без ограничений.
RULE_ALLOW_PARATROOPERS_BLOCKED_DESC=Государства не могут применять десантирование при любых обстоятельствах. Они могут создавать дивизии ВДВ, но не вправе атаковать путем десантирования.
allow_paratroopers=allow paratroopers
allow_paratroopers_desc=

[l_simp_chinese]
RULE_ALLOW_PARATROOPERS=空降
RULE_ALLOW_PARATROOPERS_ALLOWED_DESC=各国可以自由执行空降行动。
RULE_ALLOW_PARATROOPERS_BLOCKED_DESC=各国在任何情况下都不能执行空降行动。虽然仍然可以征募伞兵，但不能发动空降袭击。
allow_paratroopers=allow paratroopers
allow_paratroopers_desc=

[l_spanish]
RULE_ALLOW_PARATROOPERS=Saltos en paracaídas
RULE_ALLOW_PARATROOPERS_ALLOWED_DESC=Los países pueden realizar saltos en paracaídas libremente.
RULE_ALLOW_PARATROOPERS_BLOCKED_DESC=Los países bajo ningún concepto pueden realizar saltos en paracaídas. Las divisiones de paracaidistas podrán reclutarse, pero no podrán realizar ataques aéreos.
allow_paratroopers=allow paratroopers
