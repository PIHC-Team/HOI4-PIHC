[l_braz_por]
RULE_ALLOW_PARTY_BOOSTING=Aumentando a popularidade do partido
RULE_ALLOW_PARTY_BOOSTING_AI_ONLY_DESC=Países podem apenas aumentar a popularidade de um partido em países que não sejam controladas por um humano.
RULE_ALLOW_PARTY_BOOSTING_BLOCKED_DESC=Países não podem aumentar a popularidade de um partido em outros país.
RULE_ALLOW_PARTY_BOOSTING_FREE_DESC=Países podem aumentar a popularidade de um partido em qualquer outro país.
RULE_ALLOW_PARTY_BOOSTING_PLAYER_ONLY_DESC=Países podem apenas aumentar a popularidade de um partido em países com um jogador humano.
RULE_OPTION_PLAYER_ONLY=Apenas contra Jogadores
allow_party_boosting=allow party boosting
allow_party_boosting_desc=

